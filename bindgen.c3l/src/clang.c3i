  \c clang_disposeString.
*>
extern fn CUInt cursor_getGCCAssemblyOutput(
  CXCursor cursor,
  CUInt index,
  CXString* constraint,
  CXCursor* expr)
@cname("clang_Cursor_getGCCAssemblyOutput");

<*
  Given a CXCursor_GCCAsmStmt cursor, count the clobbers in it.
