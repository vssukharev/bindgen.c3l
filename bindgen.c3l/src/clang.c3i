*>
extern fn CUInt cursor_getGCCAssemblyNumClobbers(
  CXCursor cursor)
@cname("clang_Cursor_getGCCAssemblyNumClobbers");

<*
  Given a CXCursor_GCCAsmStmt cursor, get the Index-th clobber of it.
